# Optional analytics and marketing tags. Leave a value empty and that tool is simply off.
# They only run after the visitor accepts the matching cookie category.

# Google Analytics 4 → Admin → Data streams → Measurement ID (looks like G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity → Settings → Overview → Project ID
VITE_CLARITY_PROJECT_ID=

# Meta Pixel (Events Manager → Data sources → Pixel ID, digits only)
VITE_META_PIXEL_ID=
